"use client";

import { useEffect, useState } from "react";
import { Play } from "lucide-react";

import { cn } from "@/lib/utils";
import {
  createYouTubeEmbedUrl,
  createYouTubeThumbnailUrl,
  detectYouTubeUrl,
} from "@/lib/video";

type ClickToPlayVideoProps = {
  videoUrl: string;
  thumbnailUrl?: string;
  title?: string;
  className?: string;
  preferYouTubeThumbnail?: boolean;
};

export function ClickToPlayVideo({
  videoUrl,
  thumbnailUrl,
  title = "Video",
  className,
  preferYouTubeThumbnail = false,
}: ClickToPlayVideoProps) {
  const normalizedVideoUrl = videoUrl.trim();
  const [startedVideoUrl, setStartedVideoUrl] = useState<string | null>(null);
  const hasStarted = startedVideoUrl === normalizedVideoUrl;

  // Fade transition state: thumbnail fades out, iframe fades in
  const [fadeIn, setFadeIn] = useState(false);

  const isYouTube = detectYouTubeUrl(normalizedVideoUrl);
  const embedUrl = isYouTube
    ? createYouTubeEmbedUrl(normalizedVideoUrl)
    : null;
  const youtubeThumbnailUrl = isYouTube
    ? createYouTubeThumbnailUrl(normalizedVideoUrl)
    : null;
  // Default: prefer custom thumbnail over YouTube thumbnail.
  const previewUrl = preferYouTubeThumbnail
    ? youtubeThumbnailUrl || thumbnailUrl?.trim()
    : thumbnailUrl?.trim() || youtubeThumbnailUrl;

  // Trigger fade-in after mount when video starts
  useEffect(() => {
    if (hasStarted) {
      // Small delay to allow fade-out of thumbnail
      const timer = setTimeout(() => setFadeIn(true), 50);
      return () => clearTimeout(timer);
    }
    setFadeIn(false);
  }, [hasStarted]);

  if (!normalizedVideoUrl) return null;

  // ---- Ambient Blur Background Layer ----
  // z-index: 0 — behind everything, pointer-events: none
  const blurBackground = previewUrl ? (
    // eslint-disable-next-line @next/next/no-img-element
    <img
      src={previewUrl}
      alt=""
      aria-hidden="true"
      className="video-blur-bg"
    />
  ) : null;

  // ---- Foreground Video Layer (16:9, centered) ----
  // z-index: 2 — above blur bg and depth overlay
  if (hasStarted) {
    if (embedUrl) {
      // YouTube: render iframe in 16:9 foreground + ambient blur background
      return (
        <div
          className={cn(
            "video-wrapper",
            "group/video",
            className,
          )}
        >
          {/* z-0: Ambient blur background — fills entire container */}
          {blurBackground}

          {/* z-1: Subtle depth overlay */}
          <div className="video-depth-overlay" aria-hidden="true" />

          {/* z-2: Foreground: 16:9 iframe, centered, no crop */}
          <div
            className={cn(
              "video-foreground transition-opacity duration-300",
              fadeIn ? "opacity-100" : "opacity-0",
            )}
          >
            <iframe
              src={embedUrl}
              title={title}
              className="video-iframe"
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowFullScreen
              referrerPolicy="strict-origin-when-cross-origin"
            />
          </div>
        </div>
      );
    }

    // Direct video file: same ambient blur approach
    return (
      <div
        className={cn(
          "video-wrapper",
          "group/video",
          className,
        )}
      >
        {blurBackground}
        <div className="video-depth-overlay" aria-hidden="true" />
        <div
          className={cn(
            "video-foreground transition-opacity duration-300",
            fadeIn ? "opacity-100" : "opacity-0",
          )}
        >
          <video
            src={normalizedVideoUrl}
            title={title}
            className="video-iframe"
            autoPlay
            controls
            playsInline
            preload="auto"
          />
        </div>
      </div>
    );
  }

  // ---- Before click: Thumbnail + play button + ambient blur ----
  // Structure:
  //   <button class="video-wrapper">           (z-context root)
  //     <img class="video-blur-bg" />          (z-0, pointer-events: none)
  //     <div class="video-depth-overlay" />    (z-1, pointer-events: none)
  //     <div class="video-foreground">         (z-2)
  //       <img class="video-foreground-media" />
  //     </div>
  //     <div class="video-gradient-overlay" /> (z-2, pointer-events: none)
  //     <span class="video-play-btn">          (z-3, pointer-events: auto)
  //       ▶
  //     </span>
  //   </button>
  return (
    <button
      type="button"
      onClick={() => setStartedVideoUrl(normalizedVideoUrl)}
      className={cn(
        "video-wrapper",
        "group/video",
        "cursor-pointer",
        "focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primaryBg/60 focus-visible:ring-inset",
        className,
      )}
      aria-label={`Play video: ${title}`}
    >
      {/* z-0: Ambient blur background */}
      {blurBackground}

      {/* z-1: Subtle depth overlay */}
      <div className="video-depth-overlay" aria-hidden="true" />

      {/* z-2: Foreground: thumbnail in 16:9, centered */}
      {previewUrl ? (
        <div className="video-foreground">
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={previewUrl}
            alt={title}
            className="video-foreground-media"
            draggable={false}
          />
        </div>
      ) : (
        <div className="video-foreground video-foreground--empty">
          <span className="text-sm text-white/60">No preview available</span>
        </div>
      )}

      {/* z-2: Gradient overlay for depth (pointer-events: none in CSS) */}
      <div className="video-gradient-overlay" aria-hidden="true" />

      {/* z-3: Play button — ALWAYS ON TOP, clickable */}
      <span className="video-play-btn" aria-hidden="true">
        <span className="flex h-16 w-16 items-center justify-center rounded-full border border-white/70 bg-white/90 text-heading shadow-[0_16px_42px_-12px_rgba(15,23,42,0.58)] transition-transform duration-300 ease-out group-hover/video:scale-105 sm:h-20 sm:w-20 sm:bg-white/85 sm:backdrop-blur-md">
          <Play className="ml-1 h-7 w-7 fill-current sm:h-8 sm:w-8" />
        </span>
      </span>
    </button>
  );
}